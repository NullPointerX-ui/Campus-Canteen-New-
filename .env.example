# Copy this file, rename the copy to .env.local, and fill in your own values.
# NEVER upload .env.local to GitHub (it is already listed in .gitignore).

# PostgreSQL (from Neon.tech) - must support the pgvector extension
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# MongoDB (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=canteen

# Any long random sentence. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-secret-sentence-123456
